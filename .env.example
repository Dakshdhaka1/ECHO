# Copy to .env and adjust. DEMO_MODE=true runs everything on the recorded real-data snapshot in data/sample,
# with no API keys and no network access needed.
DEMO_MODE=true

# PostgreSQL
POSTGRES_DB=echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (cache + rate limits)
REDIS_HOST=redis
REDIS_PORT=6379

# Backend (Spring Boot)
BACKEND_PORT=8080
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_bytes
JWT_EXPIRATION_MINUTES=60
ML_SERVICE_URL=http://ml-service:8000
# Accounts registered with these emails become ADMIN (MLOps dashboard, retraining, user plans)
ADMIN_EMAILS=admin@echo.local
CORS_ALLOWED_ORIGINS=http://localhost:5173
# demo = plan changes activate instantly without payment
BILLING_MODE=demo
SCHEDULER_ENABLED=true
AUTO_RETRAIN_ON_DRIFT=true

# Shared secret between backend and ML service for /v1/admin/retrain
ML_ADMIN_TOKEN=change_me_admin_token

# ML service (FastAPI)
ML_SERVICE_PORT=8000
MODEL_DIR=/app/artifacts
# true = image also contains the training stack (retraining from the admin UI); false = slim inference image
ML_INSTALL_TRAINING=true

# Live mode (DEMO_MODE=false): SEC asks for a descriptive User-Agent with YOUR contact email
SEC_USER_AGENT=
# Optional: daily prices for the Market pillar (free key at alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# Optional LLM narrative. Default "template" needs no key; "claude" uses the Anthropic API with a grounding check.
EXPLANATION_PROVIDER=template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Frontend (dev server proxies /api to the backend; leave as is)
VITE_API_BASE_URL=/api

# Linux hosts: run the ML container as your own user so it can write the bind-mounted model folders.
# Set these to the output of `id -u` and `id -g`. Not needed on Docker Desktop (Windows/macOS).
# ECHO_UID=1000
# ECHO_GID=1000
